<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_vessel_combined.xml
    상단: 접안 예정 그래프 (BerthScheduleView)
    하단: WORKING 모선 QC 작업 현황 슬라이드 (ViewPager2)
    [2026-08-28 리팩토링 및 개선]
    - 기존 RecyclerView(입항예정리스트)는 삭제하지 않고 보존을 위해 주석 처리
    - 하단 영역에 ViewPager2(WORKING QC 현황 상시/수동조회) 배치
    - 수동 원클릭 새로고침 버튼 및 실시간 자동 갱신 토글 추가 (손가락 당기기 불편 해소)
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- 1. 상단 그래프 영역 (탭으로 접기/펼치기 가능) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!--
                        [2026-08-28 추가] 그래프 접기/펼치기 헤더 행
                        - 전체 행을 클릭하면 그래프 내용이 접히거나 펼쳐짐
                        - ivGraphChevron: 접힘(▼) / 펼침(▲) 화살표 아이콘 (180° 애니메이션 적용)
                        - 최소 터치 영역 48dp 보장
                    -->
                    <LinearLayout
                        android:id="@+id/llGraphHeader"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <!-- 📊 선석 현황 그래프 타이틀 -->
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="📊 선석 현황 그래프"
                            android:textColor="@color/on_surface"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <!-- 접기/펼치기 화살표 아이콘 (코드에서 회전 애니메이션 적용) -->
                        <ImageView
                            android:id="@+id/ivGraphChevron"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/arrow_down_float"
                            android:contentDescription="그래프 접기/펼치기"
                            app:tint="@color/md_primary" />

                    </LinearLayout>

                    <!--
                        [2026-08-28 추가] 그래프 내용 영역 (접기/펼치기 대상)
                        - id="graphContentArea" 로 Fragment 코드에서 VISIBLE/GONE 제어
                    -->
                    <HorizontalScrollView
                        android:id="@+id/scrollViewGraph"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="horizontal">

                        <com.example.vesselv2.ui.view.BerthScheduleView
                            android:id="@+id/berthScheduleView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </HorizontalScrollView>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 구분선 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider_color"
                android:layout_marginHorizontal="8dp" />

            <!-- 2. 하단 WORKING 모선 QC 현황 영역 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <!-- WORKING 모선 QC 현황 슬라이드 (ViewPager2) -->
                <LinearLayout
                    android:id="@+id/llWorkingSection"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- 섹션 타이틀 + 새로고침 버튼 + 자동 갱신 토글 + 페이지 인디케이터 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="작업 중인 모선 QC 현황"
                            android:textColor="@color/on_surface"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <!-- 실시간 자동 갱신 토글 버튼 -->
                        <TextView
                            android:id="@+id/btnAutoRefresh"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚡ 자동 off"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary"
                            android:background="@drawable/bg_rounded_corner"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:layout_marginEnd="6dp"
                            android:clickable="true"
                            android:focusable="true" />

                        <!-- 원클릭 수동 새로고침 버튼 (손가락 당기기 대신 버튼 탭) -->
                        <ImageButton
                            android:id="@+id/btnManualRefresh"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@android:drawable/ic_popup_sync"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="새로고침"
                            android:layout_marginEnd="8dp"
                            app:tint="@color/md_primary" />

                        <!-- 페이지 인디케이터 (예: 1 / 2) -->
                        <TextView
                            android:id="@+id/tvPageIndicator"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1 / 1"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <!-- ViewPager2: 모선별 QC 현황 슬라이드 (옵션 B) -->
                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/vpWorkingVessels"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                </LinearLayout>

                <!--
                    ===================================================================
                    [유지보수용 보존 주석] 기존 입항 예정 카드 리스트 (RecyclerView)
                    사용자의 요청으로 삭제하지 않고 추후 레거시 참고 및 복구를 위해 주석 처리함.
                    ===================================================================
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingHorizontal="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="16dp"
                    android:visibility="gone" />
                -->

                <!-- 빈 상태 안내 (WORKING 모선 없음) -->
                <TextView
                    android:id="@+id/tvEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="현재 작업 중인 모선이 없습니다."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <!-- 로딩 -->
                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
