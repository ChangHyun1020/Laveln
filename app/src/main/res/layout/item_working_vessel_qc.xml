<?xml version="1.0" encoding="utf-8"?>
<!--
    item_working_vessel_qc.xml
    [역할] WORKING 상태 모선 1척의 QC 작업 현황을 표시하는 ViewPager2 페이지 레이아웃
    [사용처] WorkingVesselQcAdapter → fragment_vessel_combined.xml의 vpWorkingVessels

    [상태별 표시]:
      NotLoaded → tvNotLoaded 표시 (새로고침 안내)
      Loading   → pbQcLoading 표시 (ProgressBar)
      Loaded    → llQcTable 표시 (QC 크레인별 테이블)
      NoQcInfo  → tvNoQcInfo 표시 (QC 데이터 없음 안내)
      Error     → tvNoQcInfo (오류 메시지)

    [2026-08-28] 메인화면 리팩토링 — 그래프 클릭 팝업 대신 하단 상시 표시 방식으로 변경
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- ── 모선 정보 헤더 카드 ── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/md_primary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <!-- 모선명 + 선석·ETB~ETD -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- 모선명 -->
                    <TextView
                        android:id="@+id/tvVesselName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="모선명"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <!-- 선석 + ETB~ETD -->
                    <TextView
                        android:id="@+id/tvBerthAndTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="B1 · 08/28 08:00 ~ 08/29 20:00"
                        android:textColor="#BBDEFB"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <!-- 상태 배지 -->
                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="작업중"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_status_badge"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:layout_marginStart="8dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── 전체 작업량 요약 카드 ── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@color/surface_light">

                <!-- 총 작업량 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="총 작업량"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvTotalQty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textColor="@color/on_surface"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- 구분선 -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/divider_color" />

                <!-- 양하 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="양하"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvDischargeQty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textColor="@color/on_surface"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- 구분선 -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/divider_color" />

                <!-- 적하 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="적하"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvLoadQty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textColor="@color/on_surface"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- 구분선 -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/divider_color" />

                <!-- Shift -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Shift"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvShiftQty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textColor="@color/on_surface"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── QC 크레인별 작업 현황 테이블 카드 ── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/surface_light">

                <!--
                    [NotLoaded] 조회 전 안내 메시지
                    자동 로드 X 정책: 앱 최초 실행 또는 WORKING 모선 감지 시 이 메시지 표시
                    → 사용자가 스와이프 새로고침하면 QC 데이터 로드
                -->
                <TextView
                    android:id="@+id/tvNotLoaded"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="↻  스와이프하여 새로고침하면 QC 현황을 불러옵니다."
                    android:gravity="center"
                    android:padding="24dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:visibility="visible" />

                <!-- [Loading] DGT API 조회 중 로딩 인디케이터 -->
                <ProgressBar
                    android:id="@+id/pbQcLoading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginVertical="24dp"
                    android:visibility="gone"
                    style="?android:attr/progressBarStyle" />

                <!-- [Loaded - NoQc / Error] QC 정보 없음 또는 오류 메시지 -->
                <TextView
                    android:id="@+id/tvNoQcInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="QC 작업 정보가 없습니다."
                    android:gravity="center"
                    android:padding="24dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!--
                    [Loaded] QC 크레인별 작업 현황 테이블
                    android:id="@+id/llQcTable" → 어댑터에서 visibility 제어
                -->
                <LinearLayout
                    android:id="@+id/llQcTable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_table_border"
                    android:visibility="gone">

                    <!-- 좌측: QC 작업량 세로 레이블 -->
                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="match_parent"
                        android:background="@color/md_primary"
                        android:gravity="center"
                        android:text="QC 작업량"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:padding="4dp" />

                    <!-- 우측: 완료량 / 잔여량 컬럼 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- 제1 계층 헤더: 완료량 / 잔여량 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="#E3F2FD"
                                android:gravity="center"
                                android:padding="8dp"
                                android:text="완료량"
                                android:textColor="@color/on_surface"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="#E1F5FE"
                                android:gravity="center"
                                android:padding="8dp"
                                android:text="잔여량"
                                android:textColor="@color/on_surface"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- 제2 계층 헤더: 양하 / 적하 / 양하 / 적하 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="#E3F2FD"
                                android:gravity="center"
                                android:padding="4dp"
                                android:text="양하"
                                android:textSize="12sp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="#E3F2FD"
                                android:gravity="center"
                                android:padding="4dp"
                                android:text="적하"
                                android:textSize="12sp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="#E1F5FE"
                                android:gravity="center"
                                android:padding="4dp"
                                android:text="양하"
                                android:textSize="12sp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="#E1F5FE"
                                android:gravity="center"
                                android:padding="4dp"
                                android:text="적하"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- QC 크레인별 데이터 행 컨테이너 (코드에서 동적 추가) -->
                        <LinearLayout
                            android:id="@+id/llQcRowsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
